#!/usr/bin/env bash
# Purge production edge HTML after local deploys/rollbacks: cached pages name old
# /_nuxt/* chunks, and reload recovery can fetch the same stale HTML again.
# release.yml handles CI; this hook covers kamal deploy -d prod from a laptop.
# See DEPLOYMENT.md, "Purging HTML on deploy".

set -euo pipefail

# Fixed public zone ID prevents a typo from targeting another zone.
ZONE_ID="dba6f7bd12bc97763ede3f35ef8af46d"

# Staging shares the zone; never purge production cache after a staging deploy.
if [[ "${KAMAL_DESTINATION:-}" != "prod" ]]; then
  exit 0
fi

# Only container swaps change live asset digests; include rollback, not app exec/audit.
case "${KAMAL_COMMAND:-}" in
  deploy | redeploy | rollback) ;;
  *) exit 0 ;;
esac

# CI purges with release.yml's scoped token; avoid duplicate purges and SSM reads.
if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
  echo "post-deploy: in CI, leaving the cache purge to release.yml"
  exit 0
fi

echo "post-deploy: purging the nadeshiko.co edge cache after $KAMAL_COMMAND"

# Production SSM token grants Cache-Purge only on this zone.
token="$(.kamal/ssm-secret prod CLOUDFLARE_PURGE_TOKEN)"

# URLs are unbounded; prefix/hostname/tag purges require Enterprise. Purge all;
# immutable fingerprinted assets refill from origin.
response="$(curl -sS -X POST \
  "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/purge_cache" \
  -H "Authorization: Bearer ${token}" \
  -H "Content-Type: application/json" \
  --data '{"purge_everything":true}')"

# Validate the response body: HTTP 200 can still contain success:false.
if ! printf '%s' "$response" | grep -q '"success":[[:space:]]*true'; then
  echo "post-deploy: cache purge FAILED -- readers may be served stale HTML" >&2
  echo "$response" >&2
  exit 1
fi

echo "post-deploy: edge cache purged"
