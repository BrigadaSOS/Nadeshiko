# Local SSM reads use nadeshiko-staging SSO; the helper runs
# aws sso login --profile nadeshiko-staging when credentials are unavailable.
# GH Actions supplies AWS credentials via OIDC and GITHUB_TOKEN; locally,
# an unset GITHUB_TOKEN falls back to gh auth token.
KAMAL_REGISTRY_PASSWORD=$(sh -c 'test -n "$GITHUB_TOKEN" && printf %s "$GITHUB_TOKEN" || gh auth token')
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
AWS_PAGER=""

# SSM reads fail on missing/blank values and refresh local SSO as needed.
NUXT_NADESHIKO_API_KEY=$(.kamal/ssm-secret staging NUXT_NADESHIKO_API_KEY)
NUXT_INTERNAL_PROXY_SECRET=$(.kamal/ssm-secret staging NUXT_INTERNAL_PROXY_SECRET)

# E2E sends x-rate-limit-bypass; this credential is staging-only, never production.
NUXT_RATE_LIMIT_BYPASS_SECRET=$(.kamal/ssm-secret staging RATE_LIMIT_BYPASS_SECRET)

# Server-only lookup key; deploy config enables the public flag at runtime.
# Do not rely on build-time key detection or enable lookups without this key.
NUXT_SHIRABE_API_KEY=$(.kamal/ssm-secret staging NUXT_SHIRABE_API_KEY)
