{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "extends": ["../biome.shared.jsonc"],
  "files": {
    "includes": [
      "app/**",
      "config/**",
      "content/**",
      "i18n/**",
      "nuxt.config.ts",
      "package.json",
      "server/**",
      "shared/**",
      "tailwind.config.js",
      "tsconfig.json",
      "README.md",
      ".env.example"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off",
        "noImplicitAnyLet": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // Vue SFCs: the compiler consumes `defineProps`/`defineEmits` bindings,
      // and template-only identifiers that Biome cannot see are used.
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
