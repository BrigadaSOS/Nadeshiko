NUXT_PUBLIC_ENVIRONMENT=local
NUXT_BACKEND_INTERNAL_URL=http://localhost:5000
NUXT_MEDIA_FILES_PATH=../media
NUXT_NADESHIKO_API_KEY=nade_master-api-key
# Must match the backend's INTERNAL_PROXY_SECRET (lets the backend rate limiter
# exempt traffic proxied through this frontend).
NUXT_INTERNAL_PROXY_SECRET=internal-proxy-secret
NUXT_RATE_LIMIT_V1_AUTH_MAX=30
NUXT_RATE_LIMIT_V1_API_MAX=120
NUXT_RATE_LIMIT_V1_FEEDBACK_MAX=5
NUXT_RATE_LIMIT_HTML_MAX=60

# Lets one known caller past BOTH per-IP limiters (the HTML one and the /v1
# proxy). Set it locally so the end-to-end suite is not throttled: a full run
# spends far more than 120 `/v1` requests a minute from one address, and running
# out does not fail honestly -- `/v1/search/stats` 429s while the results call
# beside it succeeds, so a page renders with no category tabs and no media
# sidebar and whichever test looked for one blames the feature.
#
# The suite sends it as `E2E_RATE_LIMIT_BYPASS_SECRET` (read from
# ../backend/.env by e2e/playwright.config.ts); the two have to match.
# Empty means the door does not exist, which is the state production is in.
NUXT_RATE_LIMIT_BYPASS_SECRET=

# Shirabe: word definitions behind each token. Server-side only, never public.
# Without a key the lookups switch themselves off and the card falls back to
# what the token itself carries (word, reading, part of speech, inflection).
NUXT_SHIRABE_API_BASE=https://shirabe.org
# Where a reader is SENT to change their Shirabe settings, as opposed to the
# address our server calls above. Point both at a local Shirabe to develop the
# account link against it.
NUXT_PUBLIC_SHIRABE_SITE=https://shirabe.org
NUXT_SHIRABE_API_KEY=

# Conditional GET on rendered HTML: attach an ETag so a signed-in reader's
# revalidation ends in a 304 instead of the whole document again. OFF, and it
# has to stay off until Cloudflare stops injecting into HTML on the zone --
# every `text/html` response is rewritten there and the validator is stripped
# on the way out, so the header costs a ~400KB string copy per render and
# reaches nobody. Before setting this to 1, check the edge actually passes one:
#   curl -sI https://nadeshiko.co/docs/api/index.html   # must show an `etag`
# The whole investigation is in server/plugins/04-html-conditional-get.ts.
NUXT_HTML_CONDITIONAL_GET=
