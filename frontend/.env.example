NUXT_PUBLIC_ENVIRONMENT=local
NUXT_BACKEND_INTERNAL_URL=http://localhost:5000
NUXT_MEDIA_FILES_PATH=../media
NUXT_NADESHIKO_API_KEY=nade_master-api-key
# Must match the backend's INTERNAL_PROXY_SECRET (lets the backend rate limiter
# exempt traffic proxied through this frontend).
NUXT_INTERNAL_PROXY_SECRET=internal-proxy-secret
NUXT_RATE_LIMIT_V1_AUTH_MAX=30
NUXT_RATE_LIMIT_V1_API_MAX=120
NUXT_RATE_LIMIT_HTML_MAX=60

# The word card a reader opens by clicking a token. Still being built, so it is
# off unless this is exactly "true" -- and off means a token is plain text that
# searches this site, as it was before the card. Set it to work on the card
# locally; leave it unset to see what production sees.
NUXT_PUBLIC_SHIRABE_WORD_CARD=true

# Shirabe: word definitions behind each token. Server-side only, never public.
# Without a key the lookups switch themselves off and the card falls back to
# what the token itself carries (word, reading, part of speech, inflection).
NUXT_SHIRABE_API_BASE=https://shirabe.org
NUXT_SHIRABE_API_KEY=
