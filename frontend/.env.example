NUXT_PUBLIC_ENVIRONMENT=local
NUXT_BACKEND_INTERNAL_URL=http://localhost:5000
NUXT_MEDIA_FILES_PATH=../media
NUXT_NADESHIKO_API_KEY=nade_master-api-key
# Match backend INTERNAL_PROXY_SECRET to exempt proxied traffic from its per-IP limiter.
NUXT_INTERNAL_PROXY_SECRET=internal-proxy-secret
NUXT_RATE_LIMIT_V1_AUTH_MAX=30
NUXT_RATE_LIMIT_V1_API_MAX=120
NUXT_RATE_LIMIT_V1_FEEDBACK_MAX=5
NUXT_RATE_LIMIT_HTML_MAX=60
NUXT_RATE_LIMIT_SHIRABE_MAX=120

# E2E bypasses HTML and /v1 IP limits and SSR admission, avoiding partial pages
# and misleading feature failures when one runner exhausts its request budget.
# Match E2E_RATE_LIMIT_BYPASS_SECRET in ../backend/.env (e2e/playwright.config.ts).
# Empty disables the bypass; keep it unset in production.
NUXT_RATE_LIMIT_BYPASS_SECRET=

# Server-only Shirabe definition key; unset disables lookups in local builds and
# cards fall back to token data (word, reading, part of speech and inflection).
NUXT_SHIRABE_API_BASE=https://shirabe.org
# Public reader settings URL; point both URLs at local Shirabe to develop linking.
NUXT_PUBLIC_SHIRABE_SITE=https://shirabe.org
NUXT_SHIRABE_API_KEY=

# HTML ETags stay off while Cloudflare rewrites text/html and strips validators:
# generating one costs a ~400KB copy per render without reaching readers.
# Before enabling, confirm the edge preserves an ETag:
#   curl -sI https://nadeshiko.co/docs/api/index.html   # must show an `etag`
# See server/plugins/04-html-conditional-get.ts.
NUXT_HTML_CONDITIONAL_GET=
