{
  "name": "nuxt-app",
  "version": "2.4.12",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev | pino-pretty",
    "lint": "npm run lint:code && npm run lint:i18n",
    "lint:code": "biome check .",
    "typecheck": "vue-tsc --noEmit",
    "verify:sri": "node scripts/verify-sri.mjs",
    "lint:i18n": "node --import tsx scripts/checkLocales.ts",
    "lint:fix": "biome check . --write",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:dev": "bash scripts/run-e2e-remote.sh dev",
    "test:e2e:prod": "bash scripts/run-e2e-remote.sh prod",
    "test:e2e:local": "E2E_BASE_URL=http://localhost:3000 playwright test --config=e2e/playwright.config.ts",
    "setup": "node --import tsx bin/setup.ts"
  },
  "dependencies": {
    "@brigadasos/nadeshiko-sdk": "*",
    "@brigadasos/nadeshiko-shared": "*",
    "@mdi/js": "^7.4.47",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "5.3.14",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@pinia/nuxt": "^1.0.2",
    "@posthog/nuxt": "^1.7.86",
    "@vue/devtools-api": "^8.1.5",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "nuxt-security": "^2.6.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pino": "^10.3.1",
    "posthog-node": "^5.51.4",
    "shiki": "^4.4.3",
    "vue-toastification": "^2.0.0-rc.5",
    "web-vitals": "5.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxtjs/critters": "^0.9.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "happy-dom": "^20.12.0",
    "nuxt": "^4.5.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
