{
  "name": "nuxt-app",
  "version": "2.2.2",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "bun --bun nuxt dev | pino-pretty",
    "lint": "biome check .",
    "typecheck": "vue-tsc --noEmit",
    "lint:fix": "biome check . --write",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:dev": "bash scripts/run-e2e-remote.sh dev",
    "test:e2e:prod": "bash scripts/run-e2e-remote.sh prod",
    "test:e2e:local": "E2E_BASE_URL=http://localhost:3000 playwright test --config=e2e/playwright.config.ts",
    "setup": "bun run bin/setup.ts"
  },
  "dependencies": {
    "@brigadasos/nadeshiko-sdk": "2.2.2-internal.8b055f5",
    "@grafana/faro-transport-otlp-http": "^2.8.2",
    "@grafana/faro-web-sdk": "^2.8.2",
    "@grafana/faro-web-tracing": "^2.8.2",
    "@mdi/js": "^7.4.47",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "5.3.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@pinia/nuxt": "^1.0.1",
    "@posthog/nuxt": "^1.7.81",
    "@vue/devtools-api": "^8.1.5",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "nuxt-security": "^2.6.0",
    "nuxt-umami": "^3.2.1",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pino": "^10.3.1",
    "shiki": "^4.3.1",
    "vue-toastification": "^2.0.0-rc.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/critters": "^0.9.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.62.0",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "happy-dom": "^20.11.1",
    "nuxt": "^4.4.8",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
