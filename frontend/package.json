{
  "name": "nuxt-app",
  "version": "2.5.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev | pino-pretty",
    "lint": "npm run lint:i18n",
    "typecheck": "vue-tsc --noEmit",
    "verify:sri": "node scripts/verify-sri.mjs",
    "lint:i18n": "node --import tsx scripts/checkLocales.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:staging": "bash scripts/run-e2e.sh staging",
    "test:e2e:dev": "bash scripts/run-e2e.sh staging",
    "test:e2e:prod": "bash scripts/run-e2e.sh prod",
    "test:e2e:local": "bash scripts/run-e2e.sh local",
    "setup": "node --import tsx bin/setup.ts"
  },
  "dependencies": {
    "@brigadasos/nadeshiko-sdk": "*",
    "@brigadasos/nadeshiko-shared": "*",
    "@mdi/js": "^7.4.47",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@pinia/nuxt": "^1.0.3",
    "@posthog/nuxt": "^1.8.0",
    "@vue/devtools-api": "^8.1.5",
    "gray-matter": "^4.0.3",
    "js-yaml": "5.5.0",
    "marked": "^18.1.1",
    "nuxt-og-image": "^7.0.7",
    "nuxt-security": "^2.7.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pino": "^10.4.0",
    "posthog-node": "^5.57.1",
    "shiki": "^4.5.0",
    "vue-toastification": "^2.0.0-rc.5",
    "web-vitals": "5.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxtjs/critters": "^0.10.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.3",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
