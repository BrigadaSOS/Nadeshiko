ENVIRONMENT=local
R2_BASE_URL=https://cdn.nadeshiko.co
LOCAL_BASE_URL=/media
MEDIA_FILES_PATH=../media
PORT=5000
UUID_NAMESPACE="a44410bd-243c-48eb-9088-38304d6f5328"

# Database
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=admin
POSTGRES_USER=nadeshiko
POSTGRES_PASSWORD=nadeshiko
POSTGRES_DB=nadedb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_SLOW_QUERY_THRESHOLD_MS=200

# Elasticsearch
# To reset the elastic user password, run:
# docker exec -it nadeshiko-elasticsearch /usr/share/elasticsearch/bin/elasticsearch-reset-password -u elastic
ELASTICSEARCH_ADMIN_USER=elastic
ELASTICSEARCH_ADMIN_PASSWORD=admin
ELASTICSEARCH_USER=nadeshiko-dev
ELASTICSEARCH_PASSWORD=nade-admin
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=nadedb_local

# API / Auth
USERNAME_API_NADEDB=admin
PASSWORD_API_NADEDB=admin
EMAIL_API_NADEDB=admin@admin.com
BETTER_AUTH_SECRET=random-better-auth-secret
ALLOWED_WEBSITE_URLS=http://localhost:3000
API_KEY_MASTER=nade_master-api-key
E2E_USER_PASSWORD=nadeshiko-e2e-local
SERVICE_API_KEY_IDS=
API_KEY_RATE_LIMIT_WINDOW_MS=60000
API_KEY_RATE_LIMIT_MAX=150
# Requests from the frontend Nitro proxy use this shared secret and bypass the per-IP rate limiter. It must match
# NUXT_INTERNAL_PROXY_SECRET in the frontend.
INTERNAL_PROXY_SECRET=internal-proxy-secret
# Salt for the pseudonymous access-log user hash; unset omits the field. Rotation invalidates prior joins, and an
# unsalted small integer is not protective.
LOG_USER_SALT=local-dev-log-salt
BASE_URL=http://localhost:3000

# OAuth
ID_OAUTH_GOOGLE=""
SECRET_OAUTH_GOOGLE=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Local uses letter-opener, so no relay is needed; deployed mail uses Amazon SES.
MAIL_FROM_EMAIL=noreply@nadeshiko.co
MAIL_FROM_NAME=Nadeshiko

# Lifecycle mail sender; defaults exist in config.ts, but it must be a real inbox because messages invite replies.
LIFECYCLE_FROM_EMAIL=dav@nadeshiko.co
LIFECYCLE_FROM_NAME=David from Nadeshiko

# When off, sweeps log candidates without sending or consuming claims, so dry runs do not mark mail as sent.
LIFECYCLE_EMAILS_ENABLED=false

# Optional staging allowlist: comma-separated addresses receive real sends; everyone else stays a dry run. Unset means
# all addresses, but only when the master switch is enabled.
# LIFECYCLE_EMAILS_ONLY_TO=dav@nadeshiko.co

# Where the feedback widget's messages are emailed. Unset skips the email; the
# message is still stored in the Feedback table either way.
FEEDBACK_NOTIFICATION_TO=

# Shirabe: parses every segment we serve. Without a key the reparse script
# refuses to run rather than writing empty tokens over the corpus.
SHIRABE_API_BASE=https://shirabe.org
SHIRABE_API_KEY=

# Account linking lets readers use their own Shirabe dictionaries rather than the service key. The redirect URI must
# exactly match the registered client; the connection secret encrypts stored tokens and OAuth state. Unset disables the
# feature, avoiding unencrypted credential storage.
SHIRABE_OAUTH_CLIENT_ID=nadeshiko
SHIRABE_OAUTH_REDIRECT_URI=
# Confidential-client secret used for every token exchange, renewal, and revocation; empty disables linking.
SHIRABE_OAUTH_CLIENT_SECRET=
# Use at least 32 characters of generated key material, or leave empty to disable linking. Do not use a passphrase:
# secretBox derives a key, so short input is guessable.
SHIRABE_CONNECTION_SECRET=
# Set only during key rotation while old rows remain; both key IDs can be read and re-encryption runs in the background.
# Do not list this under env.secret except for the rotation: Kamal aborts on unresolved names.
SHIRABE_CONNECTION_SECRET_PREVIOUS=

# Patreon account linking and membership verification for roadmap proposals.
# Register a v2 OAuth client with identity and identity.memberships scopes.
PATREON_OAUTH_CLIENT_ID=
PATREON_OAUTH_CLIENT_SECRET=
PATREON_OAUTH_REDIRECT_URI=http://localhost:3000/link/patreon/callback
PATREON_CAMPAIGN_ID=
PATREON_CAMPAIGN_URL=https://www.patreon.com/c/BrigadaSOS
# At least 32 characters of generated key material. Empty disables linking.
PATREON_CONNECTION_SECRET=

# PostHog project write key for server-side signup counts; it is public and not a personal API key. Leave empty to
# disable analytics in local and test runs.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
