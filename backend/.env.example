ENVIRONMENT=local
R2_BASE_URL=https://cdn.nadeshiko.co
LOCAL_BASE_URL=/media
MEDIA_FILES_PATH=../media
PORT=5000
UUID_NAMESPACE="a44410bd-243c-48eb-9088-38304d6f5328"

# Database
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=admin
POSTGRES_USER=nadeshiko
POSTGRES_PASSWORD=nadeshiko
POSTGRES_DB=nadedb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_SLOW_QUERY_THRESHOLD_MS=200

# Elasticsearch
# To reset the elastic user password, run:
# docker exec -it nadeshiko-elasticsearch /usr/share/elasticsearch/bin/elasticsearch-reset-password -u elastic
ELASTICSEARCH_ADMIN_USER=elastic
ELASTICSEARCH_ADMIN_PASSWORD=admin
ELASTICSEARCH_USER=nadeshiko-dev
ELASTICSEARCH_PASSWORD=nade-admin
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=nadedb_local

# API / Auth
USERNAME_API_NADEDB=admin
PASSWORD_API_NADEDB=admin
EMAIL_API_NADEDB=admin@admin.com
BETTER_AUTH_SECRET=random-better-auth-secret
ALLOWED_WEBSITE_URLS=http://localhost:3000
API_KEY_MASTER=nade_master-api-key
E2E_USER_PASSWORD=nadeshiko-e2e-local
SERVICE_API_KEY_IDS=
API_KEY_RATE_LIMIT_WINDOW_MS=60000
API_KEY_RATE_LIMIT_MAX=150
# Shared secret identifying traffic from the frontend Nitro proxy so the per-IP
# rate limiter exempts it. Must match the frontend's NUXT_INTERNAL_PROXY_SECRET.
INTERNAL_PROXY_SECRET=internal-proxy-secret
# Salt for the pseudonymous `user.hash` field on the access log (see README,
# "Access log fields"). Unset means the field is absent -- an unsalted digest of
# a small integer id protects nothing. Rotating it invalidates every prior join.
LOG_USER_SALT=local-dev-log-salt
BASE_URL=http://localhost:3000

# OAuth
ID_OAUTH_GOOGLE=""
SECRET_OAUTH_GOOGLE=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Email. Local uses letter-opener. Deployed defaults to SES; set
# MAIL_TRANSPORT=zepto plus SMTP_PASSWORD to send via smtp.zeptomail.jp.
# From-address is SES_FROM_EMAIL either way.
SES_AWS_REGION=eu-north-1
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@nadeshiko.co
SES_FROM_NAME=Nadeshiko
MAIL_TRANSPORT=ses
SMTP_ADDRESS=smtp.zeptomail.jp
SMTP_PORT=587
SMTP_USER_NAME=emailapikey
SMTP_PASSWORD=

# Where the feedback widget's messages are emailed. Unset skips the email; the
# message is still stored in the Feedback table either way.
FEEDBACK_NOTIFICATION_TO=

# Shirabe: parses every segment we serve. Without a key the reparse script
# refuses to run rather than writing empty tokens over the corpus.
SHIRABE_API_BASE=https://shirabe.org
SHIRABE_API_KEY=

# Shirabe account linking: lets a reader connect their own Shirabe account, so
# word cards answer from the dictionaries THEY configured rather than from the
# service key's empty preferences.
#
# The redirect URI is exact-matched by Shirabe against what we are registered as
# (`bin/rails oauth_clients:register` over there), so a value that does not match
# the registration fails at the consent screen. The secret encrypts the stored
# per-reader keys at rest and seals the OAuth state; unset means the whole
# feature is off, which is the right default -- the alternative is holding other
# people's credentials in the clear.
SHIRABE_OAUTH_CLIENT_ID=nadeshiko
SHIRABE_OAUTH_REDIRECT_URI=
# At least 32 characters of GENERATED key material, or empty to turn linking
# off. `openssl rand -base64 48` is fine. Not a passphrase: secretBox derives a
# key from whatever it is handed, so a short value yields a valid-looking key
# that is trivially guessable.
SHIRABE_CONNECTION_SECRET=
# Only set while rotating the value above, and only for as long as rows sealed
# with the old one still exist -- stored values carry the id of the key that
# sealed them, so both can be read at once and re-encryption is a background job
# rather than a migration with a deadline. Deliberately NOT listed under
# `env.secret` in the deploy configs: Kamal aborts a deploy on any name it
# cannot resolve, so wire it there only for the rotation itself.
SHIRABE_CONNECTION_SECRET_PREVIOUS=

# Analytics: counts accounts server-side, because the browser's signup event is
# only as reliable as the reader's content blocker. This is the PostHog project
# write key (the same public one the frontend ships), NOT a personal API key.
# Leave empty to disable capture entirely -- which is what local and test runs do.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
