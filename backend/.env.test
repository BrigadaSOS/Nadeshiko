ENVIRONMENT=local
PORT=5000
UUID_NAMESPACE=a44410bd-243c-48eb-9088-38304d6f5328
R2_BASE_URL=https://cdn.example.com

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nadeshiko
POSTGRES_PASSWORD=nadeshiko
POSTGRES_DB=nadeshiko_test
# Superuser used by `bun run test:setup` to create the role/database. These
# match the Postgres service in .github/workflows/checks.yml, which is the only
# environment where this file is the sole source of them.
#
# A local docker-compose stack is created with backend/.env's POSTGRES_ADMIN_*
# instead (admin/admin per .env.example), and --env-file does not fall back to
# .env. Shell variables beat --env-file, so pass them inline when they differ:
#   POSTGRES_ADMIN_USER=admin POSTGRES_ADMIN_PASSWORD=admin bun run test:setup
POSTGRES_ADMIN_HOST=localhost
POSTGRES_ADMIN_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_ADMIN_DB=postgres

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USER=nadeshiko-test
ELASTICSEARCH_PASSWORD=elastic
ELASTICSEARCH_INDEX=nadedb_test

# Auth
BETTER_AUTH_SECRET=test-secret
BASE_URL=http://localhost:3000
USERNAME_API_NADEDB=admin
EMAIL_API_NADEDB=admin@test.com
API_KEY_MASTER=test-master-key
INTERNAL_PROXY_SECRET=test-internal-proxy-secret

# Shirabe parse API. A placeholder, never a real key: the parseSegments tests
# stub `fetch`, so nothing is ever sent. It is here because parseSegments
# refuses to run at all on an empty key ("SHIRABE_API_KEY is not set"), and
# `config` is frozen at import time — so the guard cannot be satisfied from
# inside a test. Without this the batching tests pass on a developer machine
# that happens to have a real key in `.env` and fail in CI, which is exactly
# how they reached main.
SHIRABE_API_KEY=test-shirabe-key

# Email
SES_FROM_EMAIL=noreply@test.com
SES_FROM_NAME=Test

# Logging
LOG_LEVEL=silent
DB_LOG_LEVEL=false
