{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["dom", "es2023", "esnext.asynciterable"],
    // Enable unchecked-index diagnostics for shipped code; tests use the shared strict configuration.
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "main.ts",
    // Preloaded by the `start` script, so it ships even though nothing imports it.
    "instrumentation.ts",
    "app/**/*.ts",
    "bin/**/*.ts",
    "config/**/*.ts",
    "db/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": ["tests", "docs", "prod", "node_modules", "client", "generated.next"]
}
