{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["dom", "es2023", "esnext.asynciterable"],
    // Scoped to the shipped code that this config checks. `tests/` has 233
    // index-access hits that nothing typechecks today, so enabling it repo-wide
    // would only bury the 40 pre-existing strictness errors already in there.
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "main.ts",
    // Preloaded by the `start` script, so it ships even though nothing imports it.
    "instrumentation.ts",
    "app/**/*.ts",
    "bin/**/*.ts",
    "config/**/*.ts",
    "db/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": ["tests", "docs", "prod", "node_modules", "client"]
}
