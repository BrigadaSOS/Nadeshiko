meta {
  name: The reader's Shirabe key, for our own server only
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/v1/user/connections/shirabe/credential
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
