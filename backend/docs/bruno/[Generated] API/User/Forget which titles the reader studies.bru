meta {
  name: Forget which titles the reader studies
  type: http
  seq: 42
}

delete {
  url: {{baseUrl}}/v1/user/familiar-media
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
