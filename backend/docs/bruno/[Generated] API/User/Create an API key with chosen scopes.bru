meta {
  name: Create an API key with chosen scopes
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/v1/user/api-keys
  body: json
  auth: none
}

body:json {
  {
    "name": "Entei (read-only)",
    "scopes": [
      "READ_MEDIA"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
