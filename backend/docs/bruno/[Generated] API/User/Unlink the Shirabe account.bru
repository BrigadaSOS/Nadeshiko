meta {
  name: Unlink the Shirabe account
  type: http
  seq: 31
}

delete {
  url: {{baseUrl}}/v1/user/connections/shirabe
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
