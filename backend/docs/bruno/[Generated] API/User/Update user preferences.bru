meta {
  name: Update user preferences
  type: http
  seq: 46
}

patch {
  url: {{baseUrl}}/v1/user/preferences
  body: json
  auth: none
}

body:json {
  {
    "mediaNameLanguage": "",
    "contentRatingPreferences": {
      "nsfw": ""
    },
    "translationVisibilityPreferences": {
      "EN": "",
      "ES": ""
    },
    "translationLanguages": [],
    "wordPopup": {
      "definitionSize": ""
    },
    "searchHistory": {
      "enabled": false
    },
    "ankiProfiles": [
      {
        "id": "",
        "name": "",
        "deck": "",
        "model": "",
        "fields": [
          {
            "key": "",
            "value": ""
          }
        ],
        "key": "",
        "serverAddress": "",
        "openBrowserOnExport": false
      }
    ],
    "defaultSearchCategory": "",
    "hiddenCategories": [],
    "hiddenMedia": [
      {
        "mediaPublicId": "",
        "nameEn": "",
        "nameJa": "",
        "nameRomaji": ""
      }
    ],
    "favoriteMedia": [
      {
        "mediaPublicId": "",
        "nameEn": "",
        "nameJa": "",
        "nameRomaji": "",
        "favoritedAt": ""
      }
    ],
    "familiarMedia": {
      "enabled": false
    },
    "productEmails": {
      "enabled": false
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
