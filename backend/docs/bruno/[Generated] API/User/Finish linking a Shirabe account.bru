meta {
  name: Finish linking a Shirabe account
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/v1/user/connections/shirabe/callback
  body: json
  auth: none
}

body:json {
  {
    "code": "",
    "state": ""
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
