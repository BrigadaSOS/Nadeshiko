meta {
  name: Verify an email with an OTP
  type: http
  seq: 106
}

post {
  url: {{baseUrl}}/v1/auth/email-otp/check-verification-otp
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
