meta {
  name: Reset password with email and OTP
  type: http
  seq: 111
}

post {
  url: {{baseUrl}}/v1/auth/email-otp/reset-password
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
