meta {
  name: Move an account to a tier, or give it an override
  type: http
  seq: 81
}

patch {
  url: {{baseUrl}}/v1/admin/users/:userId/quota
  body: json
  auth: none
}

params:query {
  userId:
}

body:json {
  {
    "tierId": "plus",
    "quotaOverride": 50000,
    "reason": "Support ticket #412 - open-source dictionary integration"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
