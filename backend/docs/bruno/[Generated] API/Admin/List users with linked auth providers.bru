meta {
  name: List users with linked auth providers
  type: http
  seq: 61
}

get {
  url: {{baseUrl}}/v1/admin/users-with-providers?limit=20
  body: none
  auth: none
}

params:query {
  limit: 20
  offset:
  search:
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  const sessionToken = bru.getEnvVar("sessionToken");
  if (sessionToken) {
    req.setHeader("Cookie", "nadeshiko.session_token=" + sessionToken);
  }
}
