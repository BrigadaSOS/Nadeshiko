{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "extends": ["../biome.shared.jsonc"],
  "files": {
    "includes": [
      "main.ts",
      "instrumentation.ts",
      "app/**",
      "!app/mailers/templates",
      "bin/**",
      "config/**",
      "db/**",
      "lib/**",
      "!lib/emails",
      "scripts/**",
      "tests/**",
      "package.json",
      "tsconfig.json"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "useLiteralKeys": "off",
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off"
      }
    }
  },
  "overrides": [
    {
      // One-shot scripts and generators, where a non-null assertion is the
      // author reading their own argv rather than a claim about request data.
      "includes": ["bin/**", "scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noImplicitAnyLet": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
