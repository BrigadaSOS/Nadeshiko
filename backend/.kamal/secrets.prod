# Works locally and in GH Actions: local reads use the nadeshiko-prod SSO profile, while GH Actions supplies AWS
# credentials through OIDC and exports GITHUB_TOKEN.
KAMAL_REGISTRY_PASSWORD=$(sh -c 'test -n "$GITHUB_TOKEN" && printf %s "$GITHUB_TOKEN" || gh auth token')
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
AWS_PAGER=""

# Secrets come from AWS SSM Parameter Store. The helper fails blank reads and
# refreshes the local SSO session before returning a value.
ALLOWED_WEBSITE_URLS=$(.kamal/ssm-secret prod ALLOWED_WEBSITE_URLS)
API_KEY_MASTER=$(.kamal/ssm-secret prod API_KEY_MASTER)
INTERNAL_PROXY_SECRET=$(.kamal/ssm-secret prod INTERNAL_PROXY_SECRET)
LOG_USER_SALT=$(.kamal/ssm-secret prod LOG_USER_SALT)
BETTER_AUTH_SECRET=$(.kamal/ssm-secret prod BETTER_AUTH_SECRET)
EMAIL_API_NADEDB=$(.kamal/ssm-secret prod EMAIL_API_NADEDB)
USERNAME_API_NADEDB=$(.kamal/ssm-secret prod USERNAME_API_NADEDB)
UUID_NAMESPACE=$(.kamal/ssm-secret prod UUID_NAMESPACE)
POSTGRES_ADMIN_USER=$(.kamal/ssm-secret prod POSTGRES_ADMIN_USER)
POSTGRES_ADMIN_PASSWORD=$(.kamal/ssm-secret prod POSTGRES_ADMIN_PASSWORD)
POSTGRES_USER=$(.kamal/ssm-secret prod POSTGRES_USER)
POSTGRES_PASSWORD=$(.kamal/ssm-secret prod POSTGRES_PASSWORD)
POSTGRES_DB=$(.kamal/ssm-secret prod POSTGRES_DB)
ELASTICSEARCH_USER=$(.kamal/ssm-secret prod ELASTICSEARCH_USER)
ELASTICSEARCH_PASSWORD=$(.kamal/ssm-secret prod ELASTICSEARCH_PASSWORD)
ELASTICSEARCH_ADMIN_USER=$(.kamal/ssm-secret prod ELASTICSEARCH_ADMIN_USER)
ELASTICSEARCH_ADMIN_PASSWORD=$(.kamal/ssm-secret prod ELASTICSEARCH_ADMIN_PASSWORD)
DISCORD_CLIENT_ID=$(.kamal/ssm-secret prod DISCORD_CLIENT_ID)
DISCORD_CLIENT_SECRET=$(.kamal/ssm-secret prod DISCORD_CLIENT_SECRET)
ID_OAUTH_GOOGLE=$(.kamal/ssm-secret prod ID_OAUTH_GOOGLE)
SECRET_OAUTH_GOOGLE=$(.kamal/ssm-secret prod SECRET_OAUTH_GOOGLE)
# Who transactional mail comes from. Required -- a message with no From is not
# a message.
MAIL_FROM_EMAIL=$(.kamal/ssm-secret prod MAIL_FROM_EMAIL)
MAIL_FROM_NAME=$(.kamal/ssm-secret prod MAIL_FROM_NAME)
# ZeptoMail Send Mail Token. Missing or blank aborts the deploy at secret
# resolution — same failure mode as DISCORD_ANALYTICS_SALT.
SMTP_PASSWORD=$(.kamal/ssm-secret prod SMTP_PASSWORD)
# ZeptoMail webhook secret: missing/invalid signatures return 503; rotate the webhook authorization value together with
# this secret to prevent forged bounces from suppressing sign-in addresses.
ZEPTOMAIL_WEBHOOK_SECRET=$(.kamal/ssm-secret prod ZEPTOMAIL_WEBHOOK_SECRET)
# Zoho OAuth clears ZeptoMail suppression entries after our row is removed; deletion is the only scope. One Japan-region
# Self Client serves the shared ZeptoMail account across the listed projects.
ZOHO_CLIENT_ID=$(.kamal/ssm-secret prod ZOHO_CLIENT_ID)
ZOHO_CLIENT_SECRET=$(.kamal/ssm-secret prod ZOHO_CLIENT_SECRET)
ZOHO_REFRESH_TOKEN=$(.kamal/ssm-secret prod ZOHO_REFRESH_TOKEN)
E2E_USER_PASSWORD=$(.kamal/ssm-secret prod E2E_USER_PASSWORD)
R2_BACKUP_ACCESS_KEY_ID=$(.kamal/ssm-secret prod R2_BACKUP_ACCESS_KEY_ID)
R2_BACKUP_SECRET_ACCESS_KEY=$(.kamal/ssm-secret prod R2_BACKUP_SECRET_ACCESS_KEY)
R2_BACKUP_BUCKET=$(.kamal/ssm-secret prod R2_BACKUP_BUCKET)
R2_BACKUP_HOST_BASE=$(.kamal/ssm-secret prod R2_BACKUP_HOST_BASE)
R2_BACKUP_HOST_BUCKET=$(.kamal/ssm-secret prod R2_BACKUP_HOST_BUCKET)

# Its own key, not staging's. Staging already calls PROD Shirabe (there is no
# staging Shirabe to point at), so the two would otherwise share one credential
# and neither could be revoked without taking the other down.
SHIRABE_API_KEY=$(.kamal/ssm-secret prod SHIRABE_API_KEY)

# Encrypts reader-owned Shirabe tokens at rest; it is listed in deploy.prod.yml and must be defined here or Kamal aborts
# secret resolution.
#
# Use a different key from staging to prevent cross-environment decryption. Retain old keys until stored tokens are
# re-encrypted; unreadable tokens cannot be remotely revoked.
SHIRABE_CONNECTION_SECRET=$(.kamal/ssm-secret prod SHIRABE_CONNECTION_SECRET)
SHIRABE_OAUTH_CLIENT_SECRET=$(.kamal/ssm-secret prod SHIRABE_OAUTH_CLIENT_SECRET)
