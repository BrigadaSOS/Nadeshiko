# Works locally and in GH Actions: local reads use the nadeshiko-staging SSO profile, while GH Actions supplies AWS
# credentials through OIDC and exports GITHUB_TOKEN.
KAMAL_REGISTRY_PASSWORD=$(sh -c 'test -n "$GITHUB_TOKEN" && printf %s "$GITHUB_TOKEN" || gh auth token')
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
AWS_PAGER=""

# Secrets come from AWS SSM Parameter Store. The helper fails blank reads and
# refreshes the local SSO session before returning a value.
ALLOWED_WEBSITE_URLS=$(.kamal/ssm-secret staging ALLOWED_WEBSITE_URLS)
API_KEY_MASTER=$(.kamal/ssm-secret staging API_KEY_MASTER)
BETTER_AUTH_SECRET=$(.kamal/ssm-secret staging BETTER_AUTH_SECRET)
INTERNAL_PROXY_SECRET=$(.kamal/ssm-secret staging INTERNAL_PROXY_SECRET)
LOG_USER_SALT=$(.kamal/ssm-secret staging LOG_USER_SALT)
EMAIL_API_NADEDB=$(.kamal/ssm-secret staging EMAIL_API_NADEDB)
USERNAME_API_NADEDB=$(.kamal/ssm-secret staging USERNAME_API_NADEDB)
UUID_NAMESPACE=$(.kamal/ssm-secret staging UUID_NAMESPACE)
POSTGRES_ADMIN_USER=$(.kamal/ssm-secret staging POSTGRES_ADMIN_USER)
POSTGRES_ADMIN_PASSWORD=$(.kamal/ssm-secret staging POSTGRES_ADMIN_PASSWORD)
POSTGRES_USER=$(.kamal/ssm-secret staging POSTGRES_USER)
POSTGRES_PASSWORD=$(.kamal/ssm-secret staging POSTGRES_PASSWORD)
POSTGRES_DB=$(.kamal/ssm-secret staging POSTGRES_DB)
ELASTICSEARCH_USER=$(.kamal/ssm-secret staging ELASTICSEARCH_USER)
ELASTICSEARCH_PASSWORD=$(.kamal/ssm-secret staging ELASTICSEARCH_PASSWORD)
ELASTICSEARCH_ADMIN_USER=$(.kamal/ssm-secret staging ELASTICSEARCH_ADMIN_USER)
ELASTICSEARCH_ADMIN_PASSWORD=$(.kamal/ssm-secret staging ELASTICSEARCH_ADMIN_PASSWORD)
# The official Elasticsearch entrypoint consumes ELASTIC_PASSWORD when it
# initializes bootstrap.password. Keep the application-facing name as well.
ELASTIC_PASSWORD=$(.kamal/ssm-secret staging ELASTICSEARCH_ADMIN_PASSWORD)
DISCORD_CLIENT_ID=$(.kamal/ssm-secret staging DISCORD_CLIENT_ID)
DISCORD_CLIENT_SECRET=$(.kamal/ssm-secret staging DISCORD_CLIENT_SECRET)
ID_OAUTH_GOOGLE=$(.kamal/ssm-secret staging ID_OAUTH_GOOGLE)
SECRET_OAUTH_GOOGLE=$(.kamal/ssm-secret staging SECRET_OAUTH_GOOGLE)
# Who transactional mail comes from. Required -- a message with no From is not
# a message.
MAIL_FROM_EMAIL=$(.kamal/ssm-secret staging MAIL_FROM_EMAIL)
MAIL_FROM_NAME=$(.kamal/ssm-secret staging MAIL_FROM_NAME)
SMTP_PASSWORD=$(.kamal/ssm-secret staging SMTP_PASSWORD)
# ZeptoMail webhook secret: missing/invalid signatures return 503; rotate the webhook authorization value together with
# this secret to prevent forged bounces from suppressing sign-in addresses.
ZEPTOMAIL_WEBHOOK_SECRET=$(.kamal/ssm-secret staging ZEPTOMAIL_WEBHOOK_SECRET)
# Zoho OAuth clears ZeptoMail suppression entries after our row is removed; deletion is the only scope. One Japan-region
# Self Client serves the shared ZeptoMail account across the listed projects.
ZOHO_CLIENT_ID=$(.kamal/ssm-secret staging ZOHO_CLIENT_ID)
ZOHO_CLIENT_SECRET=$(.kamal/ssm-secret staging ZOHO_CLIENT_SECRET)
ZOHO_REFRESH_TOKEN=$(.kamal/ssm-secret staging ZOHO_REFRESH_TOKEN)
E2E_USER_PASSWORD=$(.kamal/ssm-secret staging E2E_USER_PASSWORD)

# Staging calls PROD Shirabe: the dictionary it parses against is the same
# corpus either way, and there is no staging Shirabe to point at.
SHIRABE_API_KEY=$(.kamal/ssm-secret staging SHIRABE_API_KEY)

# Encrypts reader-owned Shirabe tokens at rest; it is listed in deploy.staging.yml but must be defined here or Kamal
# aborts secret resolution and deploy-backend cannot proceed.
#
# Rotating this orphans every connection already stored, since the tokens cannot
# be decrypted with a different key.
SHIRABE_CONNECTION_SECRET=$(.kamal/ssm-secret staging SHIRABE_CONNECTION_SECRET)
SHIRABE_OAUTH_CLIENT_SECRET=$(.kamal/ssm-secret staging SHIRABE_OAUTH_CLIENT_SECRET)
