{
  "name": "backend",
  "version": "2.4.12",
  "description": "",
  "main": "main.ts",
  "type": "module",
  "scripts": {
    "setup": "node --import tsx bin/setup.ts",
    "dev": "npm run generate:api && node --import tsx --watch bin/dev.ts | pino-pretty",
    "build": "npm run generate:api",
    "start": "node --import tsx --import ./instrumentation.ts main.ts",
    "typecheck": "npm run generate:api && npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run generate:api && npm run typecheck:app",
    "lint": "npm run lint:code && npm run lint:openapi",
    "lint:code": "biome check .",
    "lint:openapi": "redocly lint",
    "lint:fix": "biome check . --write",
    "generate:api": "node --import tsx bin/generateApi.ts",
    "email:lift": "node --env-file-if-exists=.env --import tsx bin/liftEmailSuppression.ts",
    "email:audience": "node --env-file-if-exists=.env --import tsx bin/exportEmailAudience.ts",
    "email:sync-unsubscribes": "node --env-file-if-exists=.env --import tsx bin/syncCampaignsUnsubscribes.ts",
    "generate:auth-spec": "node --env-file-if-exists=.env.test --env-file-if-exists=.env --import tsx bin/generateAuthSpec.ts",
    "generate:bruno": "npm run docs:bundle && node --env-file-if-exists=.env --import tsx bin/generateBrunoCollection.ts",
    "generate:all": "npm run generate:api && npm run generate:bruno && npm run docs:build",
    "docs:bundle": "redocly bundle main -o ./docs/generated/openapi.yaml --remove-unused-components",
    "docs:bundle:public": "redocly bundle public -o ./docs/generated/openapi-public.yaml --remove-unused-components",
    "openapi:breaking": "node --import tsx bin/openapiDiff.ts breaking",
    "openapi:changelog": "node --import tsx bin/openapiDiff.ts changelog",
    "openapi:diff": "node --import tsx bin/openapiDiff.ts diff",
    "docs:build": "mkdir -p ../frontend/public/docs/api && cp ./docs/logo.png ../frontend/public/docs/api/logo.png && redocly bundle public -o ../frontend/public/docs/api/openapi.yaml --remove-unused-components && redocly build-docs ../frontend/public/docs/api/openapi.yaml -o ../frontend/public/docs/api/index.html --title \"Nadeshiko API Docs\" --disableGoogleFont --template ./docs/redoc-template.hbs",
    "docs:build:internal": "mkdir -p ../frontend/public/docs/api-internal && cp ./docs/logo.png ../frontend/public/docs/api-internal/logo.png && redocly bundle main -o ../frontend/public/docs/api-internal/openapi.yaml --remove-unused-components && redocly build-docs ../frontend/public/docs/api-internal/openapi.yaml -o ../frontend/public/docs/api-internal/index.html --title \"Nadeshiko API Docs\" --disableGoogleFont --template ./docs/redoc-template.hbs",
    "docs:serve": "node --import tsx bin/docsServe.ts",
    "docs:serve:internal": "DOCS_BUILD_COMMAND=docs:build:internal DOCS_ARTIFACTS_DIR=../frontend/public/docs/api-internal DOCS_PORT=4011 node --import tsx bin/docsServe.ts",
    "db:migrate": "node --import tsx bin/db.ts migrate",
    "db:bootstrap": "node --import tsx bin/dbBootstrap.ts",
    "db:rollback": "node --import tsx bin/db.ts rollback",
    "db:seed": "node --import tsx bin/db.ts seed",
    "db:setup": "node --import tsx bin/db.ts setup",
    "db:reset": "node --import tsx bin/db.ts reset",
    "db:prepare": "node --import tsx bin/db.ts prepare",
    "db:drop": "node --import tsx bin/db.ts drop",
    "db:status": "node --import tsx bin/db.ts status",
    "create:service-key": "node --env-file-if-exists=.env --import tsx bin/createServiceKey.ts",
    "email:backfill-feedback": "node --env-file-if-exists=.env --import tsx bin/backfillFeedbackAsk.ts",
    "email:test": "node --env-file-if-exists=.env --import tsx scripts/test-email.ts",
    "es:reindex": "node --import tsx bin/es.ts reindex",
    "es:status": "node --import tsx bin/es.ts status",
    "routes": "node --import tsx bin/routes.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:setup": "node --env-file=.env.test --import tsx bin/db.ts setup",
    "test:watch": "vitest watch"
  },
  "author": "",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^24 || >=26"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.2",
    "@brigadasos/nadeshiko-shared": "*",
    "@elastic/elasticsearch": "^9.5.1",
    "@nahkies/typescript-express-runtime": "0.26.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "better-auth": "^1.6.27",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.51.4",
    "tsx": "^4.23.13",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nahkies/openapi-code-generator": "0.26.0",
    "@redocly/cli": "^2.49.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "@usebruno/converters": "0.22.0",
    "js-yaml": "^5.4.1",
    "mmdb-lib": "^3.0.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
