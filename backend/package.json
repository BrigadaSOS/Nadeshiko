{
  "name": "backend",
  "version": "2.3.1",
  "description": "",
  "main": "main.ts",
  "type": "module",
  "scripts": {
    "setup": "node --import tsx bin/setup.ts",
    "dev": "npm run generate:api && node --import tsx --watch main.ts | pino-pretty",
    "build": "npm run generate:api",
    "start": "node --import tsx --import ./instrumentation.ts main.ts",
    "typecheck": "npm run generate:api && npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run generate:api && npm run typecheck:app",
    "lint": "npm run lint:code && npm run lint:openapi",
    "lint:code": "biome check .",
    "lint:openapi": "redocly lint",
    "lint:fix": "biome check . --write",
    "generate:api": "rm -rf generated && npm run docs:bundle && openapi-code-generator --input ./docs/generated/openapi.yaml --input-type openapi3 --output ./generated --template typescript-express --schema-builder zod-v4 --grouping-strategy first-tag && node --import tsx bin/generateOutputTypes.ts && node --import tsx bin/generateRouteAuth.ts && node --import tsx bin/generateErrorProfiles.ts && node --import tsx bin/generatePublicRoutes.ts",
    "generate:auth-spec": "node --env-file-if-exists=.env --import tsx bin/generateAuthSpec.ts",
    "generate:bruno": "npm run docs:bundle && node --env-file-if-exists=.env --import tsx bin/generateBrunoCollection.ts",
    "generate:all": "npm run generate:api && npm run generate:bruno && npm run docs:build",
    "docs:bundle": "redocly bundle main -o ./docs/generated/openapi.yaml --remove-unused-components",
    "docs:bundle:public": "redocly bundle public -o ./docs/generated/openapi-public.yaml --remove-unused-components",
    "openapi:breaking": "node --import tsx bin/openapiDiff.ts breaking",
    "openapi:changelog": "node --import tsx bin/openapiDiff.ts changelog",
    "openapi:diff": "node --import tsx bin/openapiDiff.ts diff",
    "docs:build": "mkdir -p ../frontend/public/docs/api && redocly bundle public -o ../frontend/public/docs/api/openapi.yaml --remove-unused-components && redocly build-docs ../frontend/public/docs/api/openapi.yaml -o ../frontend/public/docs/api/index.html --title \"Nadeshiko API Docs\" --disableGoogleFont --template ./docs/redoc-template.hbs",
    "docs:build:internal": "mkdir -p ../frontend/public/docs/api-internal && redocly bundle main -o ../frontend/public/docs/api-internal/openapi.yaml --remove-unused-components && redocly build-docs ../frontend/public/docs/api-internal/openapi.yaml -o ../frontend/public/docs/api-internal/index.html --title \"Nadeshiko API Docs\" --disableGoogleFont --template ./docs/redoc-template.hbs",
    "docs:serve": "node --import tsx bin/docsServe.ts",
    "docs:serve:internal": "DOCS_BUILD_COMMAND=docs:build:internal DOCS_ARTIFACTS_DIR=../frontend/public/docs/api-internal DOCS_PORT=4011 node --import tsx bin/docsServe.ts",
    "db:migrate": "node --import tsx bin/db.ts migrate",
    "db:bootstrap": "node --import tsx bin/dbBootstrap.ts",
    "db:rollback": "node --import tsx bin/db.ts rollback",
    "db:seed": "node --import tsx bin/db.ts seed",
    "db:setup": "node --import tsx bin/db.ts setup",
    "db:reset": "node --import tsx bin/db.ts reset",
    "db:prepare": "node --import tsx bin/db.ts prepare",
    "db:drop": "node --import tsx bin/db.ts drop",
    "db:status": "node --import tsx bin/db.ts status",
    "create:service-key": "node --env-file-if-exists=.env --import tsx bin/createServiceKey.ts",
    "es:reindex": "node --import tsx bin/es.ts reindex",
    "es:status": "node --import tsx bin/es.ts status",
    "routes": "node --import tsx bin/routes.ts",
    "test": "vitest run",
    "test:setup": "node --env-file=.env.test --import tsx bin/db.ts setup",
    "test:watch": "vitest watch"
  },
  "author": "",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^24 || >=26"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "@better-auth/api-key": "^1.6.25",
    "@elastic/elasticsearch": "^9.4.3",
    "@nahkies/typescript-express-runtime": "0.26.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "better-auth": "^1.6.26",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "request-ip": "^3.3.0",
    "tsx": "^4.23.1",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@nahkies/openapi-code-generator": "0.26.0",
    "@redocly/cli": "^2.40.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.5",
    "@types/recursive-readdir": "^2.2.4",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "7.2.1",
    "@usebruno/converters": "0.22.0",
    "js-yaml": "^5.2.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
