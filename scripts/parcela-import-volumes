#!/bin/sh
# Copies the data of the stack `docker compose up` ran from backend/ before Parcela (project
# `backend`) into this environment's volumes. It never changes or removes the old volumes, and
# refuses while either stack runs or when this environment already has data.
set -eu
from="${LEGACY_COMPOSE_PROJECT:-backend}"
to="${COMPOSE_PROJECT_NAME:?set it to the environment's project, like nadeshiko-primary}"
cd "$(dirname "$0")/../backend"
if [ -n "$(docker ps -q --filter "label=com.docker.compose.project=$from")" ]; then
  echo "Stop the $from stack first: (cd backend && docker compose -p $from stop)" >&2
  exit 1
fi
if [ -n "$(docker compose ps -q)" ]; then
  echo "Stop this environment first: parcela down" >&2
  exit 1
fi
for volume in nadeshiko_db nadeshiko_elasticsearch_data; do
  if ! docker volume inspect "${from}_$volume" >/dev/null 2>&1; then
    echo "No volume ${from}_$volume to import." >&2
    exit 1
  fi
  if docker volume inspect "${to}_$volume" >/dev/null 2>&1; then
    echo "${to}_$volume already exists; this environment has its own data." >&2
    exit 1
  fi
done
for volume in nadeshiko_db nadeshiko_elasticsearch_data; do
  docker volume create \
    --label "com.docker.compose.project=$to" \
    --label "com.docker.compose.volume=$volume" \
    "${to}_$volume" >/dev/null
  docker run --rm -v "${from}_$volume:/from:ro" -v "${to}_$volume:/to" postgres:17 cp -a /from/. /to/
  echo "Copied ${from}_$volume to ${to}_$volume"
done
