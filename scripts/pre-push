#!/bin/sh

# Block pushes to main that fail lint or typecheck.
# Can also be run directly: ./scripts/pre-push

# Git hooks run with a minimal environment, so add the usual Node locations
# (mise shims, nvm's current symlink) ahead of the inherited PATH.
export PATH="$HOME/.local/share/mise/shims:$HOME/.nvm/current/bin:$PATH"

cd "$(git rev-parse --show-toplevel)" || exit 1

# When called by git as a hook, stdin has push info. Skip non-main pushes.
if [ -p /dev/stdin ]; then
  pushing_to_main=false
  while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
      refs/heads/main) pushing_to_main=true ;;
    esac
  done

  if [ "$pushing_to_main" = false ]; then
    exit 0
  fi
fi

echo "Running lint and typecheck..."

echo "=> Backend: lint"
(cd backend && npm run lint:code) || { echo "Backend lint failed"; exit 1; }

echo "=> Backend: typecheck"
(cd backend && npm run typecheck) || { echo "Backend typecheck failed"; exit 1; }

echo "=> Frontend: lint"
(cd frontend && npm run lint) || { echo "Frontend lint failed"; exit 1; }

echo "=> Frontend: typecheck"
(cd frontend && npm run typecheck) || { echo "Frontend typecheck failed"; exit 1; }

echo "=> Discord: lint"
(cd discord && npm run lint) || { echo "Discord lint failed"; exit 1; }

echo "=> Discord: typecheck"
(cd discord && npm run typecheck) || { echo "Discord typecheck failed"; exit 1; }

# The SDK is generated from the OpenAPI spec, so a spec change that was not
# regenerated fails CI's drift check. Catch it before the push instead.
echo "=> SDK: drift check"
npm run sdk:codegen >/dev/null 2>&1 || { echo "SDK codegen failed"; exit 1; }
git diff --quiet -- packages/nadeshiko-sdk/generated || {
  echo "SDK generated code is stale. Review and commit packages/nadeshiko-sdk/generated."
  exit 1
}

echo "All checks passed."
