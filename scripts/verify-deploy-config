#!/usr/bin/env ruby
# frozen_string_literal: true

require "erb"
require "yaml"

ROOT = File.expand_path("..", __dir__)

def load_yaml(path)
  YAML.safe_load(ERB.new(File.read(File.join(ROOT, path))).result, aliases: true)
end

def assert!(condition, message)
  abort "Deploy configuration invalid: #{message}" unless condition
end

backend_prod = load_yaml("backend/config/deploy.prod.yml")
backend_staging = load_yaml("backend/config/deploy.staging.yml")
frontend_prod = load_yaml("frontend/config/deploy.prod.yml")
frontend_staging = load_yaml("frontend/config/deploy.staging.yml")

[[backend_prod, backend_staging, "backend"], [frontend_prod, frontend_staging, "frontend"]].each do |prod, staging, name|
  assert!(prod.fetch("service") != staging.fetch("service"), "#{name} staging and production services must differ")
  assert!(prod.fetch("image") != staging.fetch("image"), "#{name} staging and production images must differ")
end

assert!(backend_prod.dig("env", "clear", "ELASTICSEARCH_INDEX") == "nadedb_prod", "production backend must use nadedb_prod")
assert!(backend_staging.dig("env", "clear", "ELASTICSEARCH_INDEX") == "nadedb_dev", "staging backend must use nadedb_dev")
assert!(backend_staging.dig("proxy", "host") == "api-stg.nadeshiko.co", "staging API host must remain isolated")
assert!(frontend_prod.dig("proxy", "host") == "nadeshiko.co", "production frontend host must be nadeshiko.co")
assert!(frontend_staging.dig("proxy", "host") == "stg.nadeshiko.co", "staging frontend host must be stg.nadeshiko.co")
assert!(frontend_prod.dig("env", "clear", "NUXT_PUBLIC_ENVIRONMENT") == "production", "production frontend environment must be production")
assert!(frontend_staging.dig("env", "clear", "NUXT_PUBLIC_ENVIRONMENT") == "development", "staging frontend environment must be development")
assert!(!Array(frontend_prod.dig("env", "secret")).include?("NUXT_RATE_LIMIT_BYPASS_SECRET"), "production must not accept the staging rate-limit bypass")
assert!(Array(frontend_staging.dig("env", "secret")).include?("NUXT_RATE_LIMIT_BYPASS_SECRET"), "staging must expose its E2E rate-limit bypass")

staging_workflow = File.read(File.join(ROOT, ".github/workflows/staging-release.yml"))
production_workflow = File.read(File.join(ROOT, ".github/workflows/release.yml"))
frontend_dockerfile = File.read(File.join(ROOT, "frontend/Dockerfile"))
known_hosts = File.read(File.join(ROOT, ".github/known_hosts"))
nadeshiko_host_keys = known_hosts.lines.count { |line| line.match?(/^nadeshiko ssh-ed25519 [A-Za-z0-9+\/=]+$/) }
assert!(nadeshiko_host_keys == 1, "Nadeshiko deploys must use exactly one pinned Ed25519 SSH host key")
assert!(!frontend_dockerfile.match?(/^(?:ARG|ENV) POSTHOG_CLI_API_KEY/m), "PostHog API key must not be persisted in Docker build metadata")
assert!(frontend_dockerfile.include?("--mount=type=secret,id=posthog_cli_api_key"), "frontend build must consume the PostHog API key as a BuildKit secret")
assert!(production_workflow.include?('posthog_cli_api_key=${{ secrets.POSTHOG_CLI_API_KEY }}'), "production must provide the PostHog BuildKit secret")
assert!(staging_workflow.include?("E2E_EXPECTED_SHA: ${{ github.sha }}"), "staging E2E must verify the deployed SHA")
assert!(staging_workflow.include?("E2E_RUN_ID: ${{ github.run_id }}-${{ github.run_attempt }}"), "staging E2E accounts must be scoped to one workflow attempt")
assert!(staging_workflow.match?(/cleanup-e2e:\n\s+needs: e2e\n\s+if: \$\{\{ always\(\)/), "staging E2E account cleanup must be a separate job that runs after failures and timeouts")
assert!(staging_workflow.include?('"env E2E_RUN_ID=${E2E_RUN_ID} npm run db:prepare"'), "staging account preparation must pass E2E_RUN_ID through docker exec")
assert!(staging_workflow.include?('"env E2E_RUN_ID=${E2E_RUN_ID} npm run db:cleanup-e2e"'), "staging account cleanup must pass E2E_RUN_ID through docker exec")
assert!(staging_workflow.include?("bash scripts/run-e2e.sh staging"), "staging CI must use the shared E2E entry point")
assert!(production_workflow.include?("bash scripts/run-e2e.sh prod"), "production CI must use the shared E2E entry point")
assert!(production_workflow.match?(/promote-images:\n\s+needs: e2e/), "production images must only be promoted after E2E")
backend_accounts = File.read(File.join(ROOT, "backend/db/seeds.ts"))
frontend_accounts = File.read(File.join(ROOT, "frontend/e2e/auth.ts"))
assert!(backend_accounts.include?('`e2e-${runId}-${index}@nadeshiko.co`'), "backend disposable account naming changed")
assert!(frontend_accounts.include?('`e2e-${runId}-${workerIndex}@nadeshiko.co`'), "frontend disposable account naming must match the backend")

puts "Deploy configuration verified"
