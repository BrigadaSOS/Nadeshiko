{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/generated",
      "!backend/app/mailers/templates",
      "!backend/nadeshiko-params.json",
      "!backend/ssm-dev.json",
      "!frontend/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      // Test files assert against fixtures they build themselves, where a
      // non-null assertion states something about the fixture rather than
      // claiming anything about production data.
      "includes": ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**", "**/test/**", "**/tests/**", "**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noImplicitAnyLet": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["backend/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off",
            "noStaticOnlyClass": "off",
            "noThisInStatic": "off"
          }
        }
      }
    },
    {
      // One-shot scripts and generators, where a non-null assertion is the
      // author reading their own argv rather than a claim about request data.
      "includes": ["backend/bin/**", "backend/scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noImplicitAnyLet": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off",
            "noImplicitAnyLet": "off"
          }
        }
      }
    },
    {
      // Vue SFCs: the compiler consumes `defineProps`/`defineEmits` bindings,
      // and template-only identifiers that Biome cannot see are used.
      "includes": ["frontend/**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
