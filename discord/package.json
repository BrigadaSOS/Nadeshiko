{
  "name": "nadeshiko-discord",
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/bot.ts",
    "start": "node --import tsx src/bot.ts",
    "register": "node --import tsx src/register.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@brigadasos/nadeshiko-sdk": "*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.1",
    "pino": "^10.4.0",
    "posthog-node": "^5.63.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "node-gyp": "^13.1.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
