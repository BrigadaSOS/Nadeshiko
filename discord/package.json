{
  "name": "nadeshiko-discord",
  "version": "2.4.8",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/bot.ts",
    "start": "node --import tsx src/bot.ts",
    "register": "node --import tsx src/register.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@brigadasos/nadeshiko-sdk": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "pino": "^10.3.1",
    "posthog-node": "^5.49.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "node-gyp": "^13.0.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
